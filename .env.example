# Para rodar o servico FORA do Docker (npm run dev) com os bancos do compose.
# O docker compose NAO precisa deste arquivo.
PORT=3002
LOG_LEVEL=info

# ---- ORIGEM (MySQL) - usuario SOMENTE LEITURA
SRC_HOST=localhost
SRC_PORT=3307
SRC_USER=readonly
SRC_PASSWORD=readonly
SRC_DATABASE=vendas

# ---- DESTINO (Oracle)
TGT_HOST=localhost
TGT_PORT=1521
TGT_SERVICE=FREEPDB1
TGT_USER=vendas
TGT_PASSWORD=vendas

# ---- SANDBOX (mesmo Oracle do destino, schema separado; unico lugar com escrita)
SBX_USER=sandbox
SBX_PASSWORD=sandbox
